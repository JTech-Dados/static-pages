# Copie para .env e ajuste. NUNCA versione o .env.
# No Coolify, cadastre estas mesmas chaves em Environment Variables.

# Usuário admin do File Browser (criado no 1º boot)
FB_ADMIN_USER=admin

# Senha do admin (mín. 12 caracteres). Vazia = gera aleatória e
# mostra uma única vez no log do 1º boot.
# Exemplo (descomente e troque):
# FB_ADMIN_PASSWORD=TroqueEstaSenha123
#
# Sem senha definida, o login é exibido no log do 1º boot:
#   docker compose logs app | grep -E "usuário:|senha:"
FB_ADMIN_PASSWORD=

# true  = FB_ADMIN_PASSWORD sobrescreve a senha a cada boot
# false = mantém a senha trocada pela UI
FB_SYNC_ADMIN_PASSWORD=true

# Prefixo público quando um proxy publica o app num caminho (ex.: /pages): o site responde em
# https://<domínio>/pages/ e o painel em /pages/admin/. Só letras, números, _ e -. Vazio = raiz.
SP_BASE=

# true = home, 404 e favicon vêm do /srv (editáveis pelo painel). Padrão false: vêm da imagem
# e cada deploy os atualiza (um /srv/index.html antigo fica sem efeito).
HOME_FROM_SRV=false

# true = manda X-Robots-Tag: noindex (conteúdo interno, fora de buscadores)
SITE_NOINDEX=false

# Login Microsoft (Entra ID) no painel. Vazios = desligado (só usuário e senha).
# Registre um app "SPA" no Entra (sem secret) e use os IDs dele. Redirect URI a cadastrar:
# https://<domínio>[/prefixo]/admin/entra/retorno  (ou o de ENTRA_REDIRECT_URI, se definir).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_REDIRECT_URI=

# Nome exibido no File Browser
FB_BRANDING_NAME=Static Pages

# true = isola o site estático do /admin (CSP sandbox). Ver README.
SITE_SANDBOX=true

# Idioma padrão do File Browser (novos usuários)
FB_LOCALE=pt-br

# Porta publicada no host (usada pelo docker-compose / subir.bat)
HTTP_PORT=8080
# 0.0.0.0 = aberto; 127.0.0.1 = só via proxy reverso local
HTTP_BIND=0.0.0.0

# true só em rede corporativa com inspeção SSL (erro 'certificate verify failed' no build)
APK_HTTP=false

# Backup diário (serviço "backup" do compose) em ./backups
BACKUP_HORA=3
BACKUP_MANTER=7
BACKUP_NA_SUBIDA=true

# Lixeira: dias até apagar de vez o que foi excluído no painel
LIXEIRA_DIAS=30
# Visitas: janela (dias) do contador mostrado na home e em Times
VISITAS_DIAS=30

# Cota padrão de espaço por time (MB), para times sem cota própria. Aparece na tela Acessos e na
# barra de espaço do menu de quem não é admin. Upload acima da cota é recusado (413).
TEAM_QUOTA_MB=200
